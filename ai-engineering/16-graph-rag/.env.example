# ── LLM ───────────────────────────────────────────────────────────────
# LLM_MODE: auto (default; uses real if ANTHROPIC_API_KEY is set, else mock)
#           | mock (always use the deterministic mock; works with no key)
#           | real (require the key; raise if missing)
LLM_MODE=auto

# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Claude model to use (haiku is fast + cheap; good for the demo)
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ── Embeddings ────────────────────────────────────────────────────────
# Local sentence-transformers model.  all-MiniLM-L6-v2 = 22MB, fast on CPU.
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Paths ─────────────────────────────────────────────────────────────
DATA_DIR=./data
SAMPLE_DATA_DIR=./sample_data

# ── Auth (used by docker-compose api container) ───────────────────────
# Default admin is created on first boot.  CHANGE THE PASSWORD for anything
# that touches the public internet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# JWT_SECRET — leave blank to auto-generate per container (sessions are lost
# on restart).  Set a long random value for production.
JWT_SECRET=
