{
  "annotations": { "list": [] },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests / sec by status",
      "datasource": { "type": "prometheus", "uid": "prom-mlops" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" } },
      "targets": [
        {
          "expr": "sum(rate(vllm_requests_total[1m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latency (p50 / p95 / p99)",
      "datasource": { "type": "prometheus", "uid": "prom-mlops" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(vllm_request_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum(rate(vllm_request_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum(rate(vllm_request_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Drift score",
      "datasource": { "type": "prometheus", "uid": "prom-mlops" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.15 },
              { "color": "red", "value": 0.3 }
            ]
          }
        }
      },
      "targets": [{ "expr": "model_drift_score", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Cumulative cost (USD)",
      "datasource": { "type": "prometheus", "uid": "prom-mlops" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "currencyUSD" } },
      "targets": [{ "expr": "sum(vllm_request_cost_usd_total)", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Active requests",
      "datasource": { "type": "prometheus", "uid": "prom-mlops" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "none" } },
      "targets": [{ "expr": "vllm_active_requests", "refId": "A" }]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["mlops", "finetune", "vllm"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "MLOps — fine-tune serving",
  "uid": "mlops-finetune",
  "version": 1,
  "weekStart": ""
