# Heavy training image (QLoRA + flash-attn). Separate from `Dockerfile.serve`
# because pulling flash-attn wheels into the inference path is wasteful.

FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONDONTWRITEBYTECODE=1
ENV PIP_NO_CACHE_DIR=1
ENV TORCH_CUDA_ARCH_LIST="8.0;8.6;8.9;9.0"

RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.11 python3.11-venv python3-pip git curl ca-certificates \
    && update-alternatives --install /usr/bin/python python /usr/bin/python3.11 1 \
    && curl -sS https://bootstrap.pypa.io/get-pip.py | python \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/mlops

COPY requirements.txt ./
RUN pip install --upgrade pip && pip install -r requirements.txt

COPY agent ./agent
COPY scripts ./scripts
COPY tests ./tests
COPY pyproject.toml ./
COPY .env.example ./.env.example

ENV PYTHONPATH=/opt/mlops

CMD ["python", "-m", "agent.train"]
