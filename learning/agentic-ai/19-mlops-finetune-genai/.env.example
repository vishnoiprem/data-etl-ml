# Copy to .env and edit; pydantic-settings reads env vars and the dotfile in this order:
# shell env > .env > defaults. Never commit a real .env.

# --- Tracking ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=mlops-finetune-genai
MLFLOW_ARTIFACT_ROOT=/mlflow/artifacts

# --- Model ---
MODEL_NAME=meta-llama/Llama-3.1-8B-Instruct
HUGGINGFACE_TOKEN=hf_replace_with_your_token

# --- Training ---
TRAIN_LORA_R=16
TRAIN_LORA_ALPHA=32
TRAIN_LR=2e-4
TRAIN_EPOCHS=1
TRAIN_BATCH=4
TRAIN_GRAD_ACCUM=4
TRAIN_MAX_SEQ_LEN=2048
TRAIN_DATASET_ROWS=30000
TRAIN_SEED=42

# --- Budget gates (USD) ---
GATE_MAX_TRAIN_USD=200.00
GATE_MAX_RUN_SECONDS=7200
GATE_MAX_RETRY=3

# --- Serving ---
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=sk-no-auth-required
VLLM_MAX_MODEL_LEN=8192

# --- Monitoring ---
DRIFT_BASELINE_PATH=artifacts/drift_baseline.parquet
DRIFT_THRESHOLD=0.3
PROMETHEUS_PORT=9090

# --- Cost modeling (USD per 1M tokens) ---
COST_INPUT_USD_PER_1M=0.18
COST_OUTPUT_USD_PER_1M=0.18
