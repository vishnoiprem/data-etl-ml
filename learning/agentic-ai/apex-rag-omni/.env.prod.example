# Copy to .env.prod (NEVER commit). Used by infra/docker-compose.app.yml
DOMAIN=rag.example.com                # DNS A/AAAA record must point at this server
# The key the proxy sends to the API for logged-in users (never shown to browsers).
#   generate:  python3 -c "import secrets;print(secrets.token_urlsafe(32))"
APEX_PROXY_KEY=CHANGE_ME
# Optional: extra keys for scripts/CI calling the API directly (comma-separated)
# APEX_EXTRA_KEYS=
APEX_BASIC_USER=admin
#   generate:  docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
#   NOTE: in a .env file escape every $ in the hash as $$
APEX_BASIC_HASH=CHANGE_ME

# Optional: free model for "Explain in plain words". Ollama running on the same server:
#   APEX_MODEL_GATEWAY_URL=http://host.docker.internal:11434/v1
#   APEX_MODEL_NAME=qwen2.5:3b
# or a free hosted model (Groq/OpenRouter/Gemini) - see .env.example for URLs; add APEX_MODEL_GATEWAY_KEY.
