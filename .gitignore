# Python environments
venv/
.venv/
# Node — package install output (regenerated from lockfile)
node_modules/
# Secrets — never commit. The patterns below catch the common
# .env filenames (literal ".env", "foo.env", "aws.env", ".env.local",
# ".env.production", etc.) plus a few "creds/" / "secrets/" directory
# conventions, plus common AWS credential file names. The *.example
# variants are intentionally NOT ignored (see the whitelist below)
# so a fresh clone has something to copy. The "creds" / "secrets"
# directory patterns are anchored at a path boundary to avoid
# catching *legitimate* filenames like `docs/SECRETS_HANDLING.md`
# or `.secrets.baseline` (the detect-secrets convention).
.env
.env.*
*.env
*aws.env
aws_credentials
aws/credentials
gcp-credentials*
gcp-credentials.json
secrets/*
secrets.json
secrets.yaml
secrets.yml
creds/*
creds.json
.aws/
.gcp/
.azure/
!docs/SECRETS_HANDLING.md
!.secrets.baseline

# IDE
.idea/

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Jupyter Notebooks
.ipynb_checkpoints
*.checkpoint.ipynb

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log

# Data files
*.csv
*.json
*.xlsx
data/

# Whitelist known JSON config paths that the catch-all *.json would
# otherwise hide. The rule below must come AFTER *.json so it wins
# (git uses last-match-wins for ignore rules).
!*.json.example
!*.jsonl.example
# release-please state files (root of repo)
!release-please-config.json
# Grafana provisioned dashboards (ships with the MLOps fine-tune project so
# Grafana auto-loads them on first boot).
!agentic-ai/19-mlops-finetune-genai/infra/grafana/**/*.json
!.release-please-manifest.json
.devcontainer/
!.devcontainer/devcontainer.json
!.devcontainer/post-create.sh
.vscode/
!.vscode/

# Whitelist .env.example files (the catch-all *.env / .env.* rules above
# would otherwise hide the placeholder docs that tell users what to set).
!*.env.example
!.env.example
!**/.env.example

# Build artefacts (Node)
dist/
.vite/
*.tsbuildinfo
npm-debug.log*

