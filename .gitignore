data/

# Whitelist known JSON config paths that the catch-all *.json would
# otherwise hide. The rule below must come AFTER *.json so it wins
# (git uses last-match-wins for ignore rules).
!*.json.example
!*.jsonl.example
.devcontainer/
!.devcontainer/devcontainer.json
!.devcontainer/post-create.sh
.vscode/
!.vscode/

# Large ML files (kept in LFS for some specific paths; ignored for the rest)
*.bin
*.h5
*.parquet
*.so
*.dylib
*.jar
*.crc
*.zip
*.pth
*.safetensors
*.safetensors filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text

