# apex-rag-omni — environment variables
# Copy to `.env` and fill in. NEVER commit `.env`.
# All vars are prefixed with APEX_.

# --- Auth ---
# Comma-separated list of valid X-API-Key values. Rotate before deploy.
APEX_API_KEYS=devkey-change-me

# --- Infra ---
APEX_QDRANT_URL=http://localhost:6333
APEX_ES_URL=http://localhost:9200

# --- Eval store ---
# Leave empty to use the JSONL fallback (reads eval/reports/eval_*.json).
# Set to a Postgres URL for prod (table created on first eval run).
# APEX_POSTGRES_URL=postgresql+psycopg://apex:apex@localhost:5432/apex
APEX_POSTGRES_URL=

# --- Model gateway (used by the future real LLM call; not wired yet) ---
# APEX_MODEL_GATEWAY_URL=https://gateway.internal/v1
# APEX_MODEL_GATEWAY_KEY=

# --- Web ---
# The Next.js frontend origin. NEVER use `*` here.
APEX_FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# --- Tunables ---
# Audit queue capacity. Drop-on-overflow with a counter.
APEX_AUDIT_QUEUE_MAX=10000
# Max chars in /query body. Larger payloads = 422.
APEX_MAX_QUERY_CHARS=2000
# Per-dependency timeout for /readyz, in milliseconds.
APEX_READYZ_TIMEOUT_MS=500

# --- Uploads ---
# Where uploaded documents live (mount a persistent volume here in prod).
# APEX_DATA_DIR=./data
# APEX_MAX_UPLOAD_BYTES=5242880
