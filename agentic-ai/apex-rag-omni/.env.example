# apex-rag-omni — environment variables
# Copy to `.env` and fill in. NEVER commit `.env`.
# All vars are prefixed with APEX_.

# --- Auth ---
# Comma-separated list of valid X-API-Key values. Rotate before deploy.
APEX_API_KEYS=devkey-change-me

# --- Infra ---
APEX_QDRANT_URL=http://localhost:6333
APEX_ES_URL=http://localhost:9200

# --- Eval store ---
# Leave empty to use the JSONL fallback (reads eval/reports/eval_*.json).
# Set to a Postgres URL for prod (table created on first eval run).
# APEX_POSTGRES_URL=postgresql+psycopg://apex:apex@localhost:5432/apex
APEX_POSTGRES_URL=

# --- Free model for "Explain in plain words" (optional) ---
# Any OpenAI-compatible endpoint. It only re-explains an already-verified answer;
# the explanation is checked against the sources and dropped if it doesn't match.
#   Local + private (recommended):  ollama pull qwen2.5:3b  (≈2 GB)
APEX_MODEL_GATEWAY_URL=http://localhost:11434/v1
APEX_MODEL_NAME=qwen2.5:3b
#   Free hosted alternatives (your question + cited passages leave your network):
#   Groq:       APEX_MODEL_GATEWAY_URL=https://api.groq.com/openai/v1     APEX_MODEL_NAME=llama-3.1-8b-instant        APEX_MODEL_GATEWAY_KEY=...
#   OpenRouter: APEX_MODEL_GATEWAY_URL=https://openrouter.ai/api/v1       APEX_MODEL_NAME=meta-llama/llama-3.2-3b-instruct:free  APEX_MODEL_GATEWAY_KEY=...
#   Gemini:     APEX_MODEL_GATEWAY_URL=https://generativelanguage.googleapis.com/v1beta/openai  APEX_MODEL_NAME=gemini-2.0-flash  APEX_MODEL_GATEWAY_KEY=...
# Leave APEX_MODEL_GATEWAY_URL empty to disable (answers still work, verbatim + cited).
# APEX_MODEL_GATEWAY_KEY=

# --- Web ---
# The Next.js frontend origin. NEVER use `*` here.
APEX_FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# --- Tunables ---
# Audit queue capacity. Drop-on-overflow with a counter.
APEX_AUDIT_QUEUE_MAX=10000
# Max chars in /query body. Larger payloads = 422.
APEX_MAX_QUERY_CHARS=2000
# Per-dependency timeout for /readyz, in milliseconds.
APEX_READYZ_TIMEOUT_MS=500

# --- Uploads ---
# Where uploaded documents live (mount a persistent volume here in prod).
# APEX_DATA_DIR=./data
# APEX_MAX_UPLOAD_BYTES=5242880
