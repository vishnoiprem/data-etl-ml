# Secrets
.env
.env.*
!.env.example
.huggingface/

# Un-ignore the Grafana dashboards we ship (the repo-root .gitignore has
# a generic `*.json` rule that catches these — we want to ship the dashboards
# so Grafana provisions them on first boot).
!infra/grafana/**/*.json
