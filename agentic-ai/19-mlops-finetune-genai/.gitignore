# Local-only artifacts (recreated by `make up` / `make train`)
data/
mlruns/
sft-output/
artifacts/
vllm-cache/
eval-output/
.cache/
*.parquet
*.bin
*.safetensors
__pycache__/
*/__pycache__/
*/*/__pycache__/
