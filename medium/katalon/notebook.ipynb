    "## Prototype E — Idempotent outbox for agent tool calls (Python + sqlite3)\n",
    "\n",
    "**What this proves:** An agent's side effects — `create_defect`, `update_test_case`, `send_notification` — can be made **exactly-once against the business system** by writing tool-call rows to a local transactional outbox inside the same DB transaction that records the agent's reasoning, and draining the outbox with an idempotency key.\n",
    "\n",
    "**What the panel tests:** Your understanding of the **transactional outbox pattern**, the role of **idempotency keys**, why \"exactly once\" is a property of the business result and not the message bus, and how an agent's tool surface should be the smallest possible action space with confirmation gates for high-impact mutations.\n",
    "\n",
    "**Talking points:**\n",
    "- Reasoning + tool calls live in **one DB transaction** — there is no \"agent crashed between deciding and acting\" failure mode.\n",
    "- Each tool call carries an **idempotency key** so retries cannot duplicate real side effects (defects, notifications, edits).\n",
    "- A separate drainer consumes the outbox and applies mutations, retrying transient failures.\n",
    "- High-impact actions require a **confirmation gate** (e.g., `requires_confirmation=true`).\n",
    "- Cross-tenant, read-only, audit-logged, kill-switchable — the agent surface is intentionally narrow."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Prototype E — Idempotent outbox for agent tool calls (Python + sqlite3)\n",
    "import sqlite3, json, uuid, time, os, tempfile\n",
    "from contextlib import contextmanager\n",
    "\n",
    "DB_PATH = os.path.join(tempfile.gettempdir(), \"agent_outbox_demo.sqlite\")\n",
    "if os.path.exists(DB_PATH):\n",
    "    os.remove(DB_PATH)\n",
    "\n",
    "con = sqlite3.connect(DB_PATH, isolation_level=None)\n",
    "con.execute(\"PRAGMA journal_mode=WAL;\")\n",
    "con.execute(\"PRAGMA foreign_keys=ON;\")\n",
    "\n",
    "con.executescript(\"\"\"\n",
    "CREATE TABLE agent_run (\n",
    "    run_id        TEXT PRIMARY KEY,\n",
    "    tenant_id     TEXT NOT NULL,\n",
    "    reasoning     TEXT NOT NULL,\n",
    "    created_at    REAL NOT NULL\n",
    ");\n",
    "CREATE TABLE tool_outbox (\n",
    "    tool_call_id   TEXT PRIMARY KEY,         -- idempotency key\n",
    "    run_id         TEXT NOT NULL REFERENCES agent_run(run_id),\n",
    "    tenant_id      TEXT NOT NULL,\n",
    "    tool_name      TEXT NOT NULL,\n",
    "    payload_json   TEXT NOT NULL,\n",
    "    requires_confirmation INTEGER NOT NULL DEFAULT 0,\n",
    "    confirmed         INTEGER NOT NULL DEFAULT 0,\n",
    "    status         TEXT NOT NULL,            -- PENDING, CONFIRMED, APPLIED, FAILED\n",
    "    attempts       INTEGER NOT NULL DEFAULT 0,\n",
    "    last_error     TEXT,\n",
    "    applied_at     REAL\n",
    ");\n",
    "CREATE INDEX idx_outbox_status ON tool_outbox(status);\n",
    "CREATE TABLE external_effect (\n",
    "    effect_id     TEXT PRIMARY KEY,\n",
    "    tool_call_id  TEXT NOT NULL UNIQUE,      -- enforces idempotency on the apply side\n",
    "    tool_name     TEXT NOT NULL,\n",
    "    tenant_id     TEXT NOT NULL,\n",
    "    payload_json  TEXT NOT NULL,\n",
    "    created_at    REAL NOT NULL\n",
    ");\n",
    "\"\"\")\n",
    "print(f\"schema initialized at {DB_PATH}\")"
   ],
   "outputs": [],
   "execution_count": null
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "# --- 1. The agent records its reasoning + tool calls in ONE transaction ---\n",
    "@contextmanager\n",
    "def tx():\n",
    "    con.execute(\"BEGIN IMMEDIATE;\")\n",
    "    try:\n",
    "        yield\n",
    "        con.execute(\"COMMIT;\")\n",
    "    except Exception:\n",
    "        con.execute(\"ROLLBACK;\")\n",
    "        raise\n",
    "\n",
    "def agent_propose(run_id: str, tenant_id: str, reasoning: str, calls: list):\n",
    "    \"\"\"calls: list of dicts with tool_name, payload, requires_confirmation, idempotency_key\"\"\"\n",
    "    with tx():\n",
    "        con.execute(\n",
    "            \"INSERT INTO agent_run(run_id, tenant_id, reasoning, created_at) VALUES (?,?,?,?)\",\n",
    "            (run_id, tenant_id, reasoning, time.time()),\n",
    "        )\n",
    "        for c in calls:\n",
    "            initial_status = \"PENDING\" if c[\"requires_confirmation\"] else \"CONFIRMED\"\n",
    "            con.execute(\n",
    "                \"INSERT INTO tool_outbox(tool_call_id, run_id, tenant_id, tool_name, payload_json, \"\n",
    "                \"requires_confirmation, confirmed, status, attempts) \"\n",
    "                \"VALUES (?,?,?,?,?,?,?,?,0)\",\n",
    "                (c[\"idempotency_key\"], run_id, tenant_id, c[\"tool_name\"],\n",
    "                 json.dumps(c[\"payload\"]), int(c[\"requires_confirmation\"]),\n",
    "                 0 if c[\"requires_confirmation\"] else 1, initial_status),\n",
    "            )\n",
    "\n",
    "def confirm(tool_call_id: str):\n",
    "    with tx():\n",
    "        con.execute(\"UPDATE tool_outbox SET confirmed=1, status='CONFIRMED' WHERE tool_call_id=? AND requires_confirmation=1\",\n",
    "                    (tool_call_id,))\n",
    "\n",
    "# --- 2. The drainer applies side effects with idempotency ---\n",
    "def drain(max_apply: int = 100):\n",
    "    cur = con.execute(\n",
    "        \"SELECT tool_call_id, run_id, tenant_id, tool_name, payload_json \"\n",
    "        \"FROM tool_outbox WHERE status='CONFIRMED' ORDER BY tool_call_id\"\n",
    "    )\n",
    "    pending = cur.fetchall()\n",
    "    applied = 0\n",
    "    for tool_call_id, run_id, tenant_id, tool_name, payload_json in pending:\n",
    "        if applied >= max_apply:\n",
    "            break\n",
    "        try:\n",
    "            with tx():\n",
    "                con.execute(\n",
    "                    \"INSERT OR IGNORE INTO external_effect(effect_id, tool_call_id, tool_name, tenant_id, payload_json, created_at) \"\n",
    "                    \"VALUES (?,?,?,?,?,?)\",\n",
    "                    (str(uuid.uuid4()), tool_call_id, tool_name, tenant_id, payload_json, time.time()),\n",
    "                )\n",
    "                con.execute(\n",
    "                    \"UPDATE tool_outbox SET status='APPLIED', attempts=attempts+1, applied_at=? WHERE tool_call_id=?\",\n",
    "                    (time.time(), tool_call_id),\n",
    "                )\n",
    "            applied += 1\n",
    "        except Exception as e:\n",
    "            with tx():\n",
    "                con.execute(\n",
    "                    \"UPDATE tool_outbox SET status='FAILED', attempts=attempts+1, last_error=? WHERE tool_call_id=?\",\n",
    "                    (str(e), tool_call_id),\n",
    "                )\n",
    "    return applied\n",
    "\n",
    "print(\"helpers defined.\")"
   ],
   "outputs": [],
   "execution_count": null
