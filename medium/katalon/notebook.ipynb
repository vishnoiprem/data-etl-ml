    "# --- 5. Reconcile ---\n",
    "from pyspark.sql.functions import coalesce, lit, when\n",
    "\n",
    "recon = (\n",
    "    producer_df.alias(\"p\")\n",
    "    .join(accepted_df.groupBy(\"execution_id\",\"tenant_id\").agg(F.sum(\"accepted_count\").alias(\"accepted_count_raw\")), [\"execution_id\",\"tenant_id\"], \"full_outer\")\n",
    "    .join(silver_df, [\"execution_id\",\"tenant_id\"], \"full_outer\")\n",
    "    .join(served_df, [\"execution_id\",\"tenant_id\"], \"full_outer\")\n",
    "    .select(\n",
    "        \"execution_id\",\"tenant_id\",\n",
    "        coalesce(\"p.declared_count\", lit(0)).alias(\"producer_declared\"),\n",
    "        coalesce(\"accepted_count_raw\", lit(0)).alias(\"accepted_count\"),\n",
    "        coalesce(\"silver_count\", lit(0)).alias(\"silver_count\"),\n",
    "        coalesce(\"served_count\", lit(0)).alias(\"served_count\"),\n",
    "    )\n",
    "    .withColumn(\"status\",\n",
    "        when(F.col(\"producer_declared\") == 0, lit(\"ORPHAN_ACCEPTED\"))\n",
    "        .when(F.col(\"accepted_count\") < F.col(\"producer_declared\"), lit(\"MISSING_IN_ACCEPTED\"))\n",
    "        .when(F.col(\"silver_count\")    < F.col(\"producer_declared\"), lit(\"MISSING_IN_SILVER\"))\n",
    "        .when(F.col(\"served_count\")    != F.col(\"silver_count\"),  lit(\"SERVED_STALE\"))\n",
    "        .otherwise(lit(\"OK\"))\n",
    "    )\n",
    "    .withColumn(\"severity\",\n",
    "        when(F.col(\"status\").isin(\"MISSING_IN_SILVER\",\"ORPHAN_ACCEPTED\"), lit(\"SEV_2\"))\n",
    "        .when(F.col(\"status\") == \"MISSING_IN_ACCEPTED\", lit(\"SEV_3\"))\n",
    "        .when(F.col(\"status\") == \"SERVED_STALE\", lit(\"SEV_3\"))\n",
    "        .otherwise(lit(\"OK\"))\n",
    "    )\n",
    "    .orderBy(\"execution_id\")\n",
    ")\n",
    "recon.show(20, truncate=False)"
