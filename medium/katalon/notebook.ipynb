   "cell_type": "code",
   "metadata": {},
   "source": [
    "# Prototype D — Retrieval evaluation harness (pure Python, no Spark)\n",
    "from collections import defaultdict\n",
    "from typing import Callable, Dict, List, Sequence\n",
    "import math\n",
    "import random\n",
    "\n",
    "random.seed(42)\n",
    "\n",
    "# --- 1. Toy corpus & gold set ---\n",
    "# documents are immutable per tenant; doc_id -> (tenant_id, text)\n",
    "corpus = {\n",
    "    \"d1\": (\"t1\", \"login page returns 500 after deploy\"),\n",
    "    \"d2\": (\"t1\", \"checkout button click times out\"),\n",
    "    \"d3\": (\"t1\", \"search index stale, results wrong\"),\n",
    "    \"d4\": (\"t2\", \"login fails with new auth provider\"),\n",
    "    \"d5\": (\"t2\", \"checkout 500 on weekends\"),\n",
    "    \"d6\": (\"t2\", \"search returns empty page\"),\n",
    "    \"d7\": (\"t3\", \"flaky logout in safari\"),\n",
    "}\n",
    "\n",
    "# gold: q_id -> (query, tenant_id, [relevant_doc_ids])\n",
    "gold = {\n",
    "    \"q1\": (\"t1 login 500\",         \"t1\", [\"d1\"]),\n",
    "    \"q2\": (\"t1 checkout slow\",     \"t1\", [\"d2\"]),\n",
    "    \"q3\": (\"t1 search wrong\",      \"t1\", [\"d3\"]),\n",
    "    \"q4\": (\"t2 login new auth\",    \"t2\", [\"d4\"]),\n",
    "    \"q5\": (\"t2 checkout weekend\",  \"t2\", [\"d5\"]),\n",
    "    \"q6\": (\"t2 search empty\",      \"t2\", [\"d6\"]),\n",
    "    \"q7\": (\"t3 logout flaky\",      \"t3\", [\"d7\"]),\n",
    "}\n",
    "\n",
    "# --- 2. Two retrievers: lexical (toy) and \"vector\" (random with tenant filter) ---\n",
    "def lexical_retrieve(query: str, tenant_id: str, k: int = 3) -> List[str]:\n",
    "    tokens = set(query.lower().split())\n",
    "    scored = []\n",
    "    for doc_id, (doc_tenant, text) in corpus.items():\n",
    "        if doc_tenant != tenant_id:\n",
    "            continue  # tenant filter is mandatory\n",
    "        words = set(text.lower().split())\n",
    "        overlap = len(tokens & words)\n",
    "        if overlap:\n",
    "            scored.append((overlap, doc_id))\n",
    "    scored.sort(reverse=True)\n",
    "    return [doc_id for _, doc_id in scored[:k]]\n",
    "\n",
    "def vector_retrieve(query: str, tenant_id: str, k: int = 3) -> List[str]:\n",
    "    candidates = [d for d, (t, _) in corpus.items() if t == tenant_id]\n",
    "    random.shuffle(candidates)\n",
    "    return candidates[:k]\n",
    "\n",
    "# --- 3. Metrics ---\n",
    "def recall_at_k(retrieved: Sequence[str], relevant: Sequence[str], k: int) -> float:\n",
    "    if not relevant:\n",
    "        return 0.0\n",
    "    return len(set(retrieved[:k]) & set(relevant)) / len(set(relevant))\n",
    "\n",
    "def mrr(retrieved_by_q: Dict[str, List[str]]) -> float:\n",
    "    rr_total = 0.0\n",
    "    for q_id, (_, _, relevant) in gold.items():\n",
    "        rel_set = set(relevant)\n",
    "        for rank, doc_id in enumerate(retrieved_by_q[q_id], start=1):\n",
    "            if doc_id in rel_set:\n",
    "                rr_total += 1.0 / rank\n",
    "                break\n",
    "    return rr_total / len(gold)\n",
    "\n",
    "def cross_tenant_leakage(retrieved_by_q: Dict[str, List[str]]) -> int:\n",
    "    leaks = 0\n",
    "    for q_id, retrieved in retrieved_by_q.items():\n",
    "        _, tenant_id, _ = gold[q_id]\n",
    "        for doc_id in retrieved:\n",
    "            if corpus[doc_id][0] != tenant_id:\n",
    "                leaks += 1\n",
    "    return leaks\n",
    "\n",
    "def evaluate(retriever: Callable, k: int = 3) -> Dict[str, float]:\n",
    "    retrieved_by_q: Dict[str, List[str]] = {}\n",
    "    recalls = []\n",
    "    for q_id, (query, tenant_id, relevant) in gold.items():\n",
    "        retrieved = retriever(query, tenant_id, k=k)\n",
    "        retrieved_by_q[q_id] = retrieved\n",
    "        recalls.append(recall_at_k(retrieved, relevant, k))\n",
    "    return {\n",
    "        f\"recall@{k}\": sum(recalls) / len(recalls),\n",
    "        \"mrr\": mrr(retrieved_by_q),\n",
    "        \"cross_tenant_leakage\": cross_tenant_leakage(retrieved_by_q),\n",
    "    }\n",
    "\n",
    "print(f\"lexical  -> {evaluate(lexical_retrieve, k=3)}\")\n",
    "print(f\"vector   -> {evaluate(vector_retrieve, k=3)}\")"
   ],
   "outputs": [],
   "execution_count": null
  },
