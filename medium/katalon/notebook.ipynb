    "    (\"e3\",\"t1\",12),\n",
    "    (\"e4\",\"t2\",6),\n",
    "    # e5 dropped (no manifest → quarantined)\n",
    "]\n",
    "silver_df = spark.createDataFrame(silver, \"execution_id STRING, tenant_id STRING, silver_count INT\")\n",
    "\n",
    "# --- 4. Served (dashboard view) ---\n",
    "served = [\n",
    "    (\"e1\",\"t1\",10),\n",
    "    (\"e2\",\"t1\",8),   # dashboard stale, still shows declared\n",
    "    (\"e3\",\"t1\",12),\n",
    "    (\"e4\",\"t2\",6),\n",
    "]\n",
    "served_df = spark.createDataFrame(served, \"execution_id STRING, tenant_id STRING, served_count INT\")\n",
