%% Ad Click Aggregation Pipeline — component architecture
%% The central idea: ONE immutable log, TWO consumers with different SLAs.
%%   speed layer  -> dashboards, <10s, provisional
%%   batch layer  -> billing,    T+1,  authoritative
flowchart TB
    subgraph EDGE["Edge — global PoPs"]
        SDK["Ad SDK / pixel<br/>impressions, clicks, conversions"]
        COLL["Collector<br/>stamp event_id (UUIDv7)<br/>event_ts + ingest_ts"]
        F1{{"FRAUD TIER 1 — inline, µs<br/>datacenter IP · bot UA · malformed<br/>per-IP rate limit · N clicks/s/user"}}
        SDK --> COLL --> F1
    end

    F1 -->|"dropped ~8%<br/>(deterministic)"| DROP[("rejected_events<br/>audit trail")]

    subgraph INGEST["Ingest"]
        K1["Kafka: raw_ad_events<br/>1024 partitions<br/>key = hash(user_id)<br/>acks=all, isr=2, 7d retention"]
    end
    F1 -->|"1M–10M events/s"| K1

    subgraph DEDUP["Dedup — keyed by user"]
        FD["Flink: dedup<br/>state key (user_id, ad_id)<br/>RocksDB + 60s TTL<br/>checkpoint every 10s"]
    end
    K1 --> FD

    FD -->|"duplicates"| DUP[("duplicate_events<br/>audit trail")]

    K2["Kafka: deduped_clicks<br/>RE-KEYED key = hash(campaign_id, salt)<br/>⚠ partition key CHANGES here"]
    FD --> K2

    subgraph SPEED["SPEED LAYER — provisional"]
        AGG["Flink: windowed aggregation<br/>tumbling 1m / 5m / 1h / 1d<br/>two-stage salted for hot keys"]
        OLAP[("Druid / Pinot<br/>idempotent upsert on<br/>(window_start, ad_id, salt)")]
        AGG --> OLAP
    end
    K2 --> AGG

    subgraph LAKE["Immutable log"]
        RAW[("Iceberg: raw_events<br/>Parquet+zstd, partitioned by hour<br/>1 year · ~3 PB")]
    end
    K2 --> RAW
    K1 -.->|"also archived pre-dedup<br/>for replay"| RAW

    subgraph FRAUD2["FRAUD TIER 2 — async, minutes–hours"]
        ML["ML scoring<br/>click farms · coordinated networks<br/>conversion anomalies · device fingerprints"]
        VERD[("Iceberg: fraud_verdicts<br/>event_id → verdict, score, reason")]
        ML --> VERD
    end
    RAW --> ML

    subgraph BATCH["BATCH LAYER — authoritative"]
        RECON["Spark: billing reconciliation<br/>raw ⨝ verdicts, T+1<br/>MERGE (idempotent), never append"]
        LEDGER[("Iceberg: billing_ledger<br/>append-only · 7 years")]
        ADJ[("adjustment_records<br/>speed vs batch delta")]
        RECON --> LEDGER
        RECON --> ADJ
    end
    RAW --> RECON
    VERD --> RECON

    DASH["Advertiser dashboard<br/>spend · CTR · conversions<br/>'as of 14:32:05 (provisional)'"]
    INV["Invoices<br/>billable = raw − tier1 − tier2"]
    OLAP --> DASH
    LEDGER --> INV
    ADJ -.->|"published delta,<br/>history never mutated"| DASH

    MON{{"Watermark-lag SLO<br/>alert if > 10s behind wall clock"}}
    FD -.-> MON
    AGG -.-> MON

    classDef speed fill:#306FC7,stroke:#1d4a8a,color:#fff
    classDef batch fill:#43938F,stroke:#2d6360,color:#fff
    classDef fraud fill:#DA3832,stroke:#93251f,color:#fff
    classDef store fill:#F6C24A,stroke:#b88c22,color:#222
    class SPEED,AGG,OLAP,DASH speed
    class BATCH,RECON,LEDGER,INV,ADJ batch
    class F1,FRAUD2,ML,VERD,DROP fraud
    class K1,K2,RAW,DUP,DUP store
