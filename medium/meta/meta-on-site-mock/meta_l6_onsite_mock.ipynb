    "# L6 add-on: build the gold eval set from corrected_answer (labeled training data)\n",
    "gold_sql = \"\"\"\n",
    "SELECT\n",
    "    t.query,\n",
    "    t.response AS model_answer,\n",
    "    f.corrected_answer AS human_answer,\n",
    "    t.prompt_version\n",
    "FROM traces t\n",
