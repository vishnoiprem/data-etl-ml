<cell id="cell-9"># === Section 5: DLQ behavior ===
svc2 = _L5.IngestionService()
bad = [_L5.Document(source='bad.json', raw='{"text": missing}', content_type='json')]
r3 = svc2.ingest(bad)
print(f'bad json -> dlq: {len(r3.dead_letter)}')
for dl in r3.dead_letter:
