# CODEOWNERS — auto-assigns reviewers for PRs that touch these paths.
# Last match wins (GitHub semantics), so put more-specific rules BELOW
# more-generic ones.
#
# To require a review from CODEOWNERS on a path, enable "Require review
# from Code Owners" under Settings → Branches → main → Require status
# checks / reviewers. (Optional — this file is informative even without
# the rule enabled.)

# Default owner for the whole repo
*    @vishnoiprem

# CI/CD infra — review the container build + the workflows before
# changes land
/.github/workflows/leads-cd.yml  @vishnoiprem
/.github/workflows/leads-ci.yml  @vishnoiprem
/.github/CODEOWNERS              @vishnoiprem
/.github/dependabot.yml          @vishnoiprem

# Container image — Dockerfile + .dockerignore changes ship a new
# image on the next push to main
/projects/leads-pipeline/draft-cron/Dockerfile      @vishnoiprem
/projects/leads-pipeline/draft-cron/.dockerignore   @vishnoiprem

