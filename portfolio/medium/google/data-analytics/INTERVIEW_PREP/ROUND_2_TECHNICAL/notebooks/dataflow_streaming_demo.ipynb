  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Dataflow Streaming Pipeline Demo\n",
        "\n",
        "Interactive demonstration of Dataflow streaming patterns:\n",
        "- Event-time processing with watermarks\n",
        "- Windowing (fixed & session)\n",
        "- Late data handling\n",
        "- Exactly-once deduplication\n",
        "- Monitoring & debugging\n",
        "\n",
        "**This notebook simulates the streaming pipeline logic locally for understanding.**"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Setup\n",
        "import apache_beam as beam\n",
        "from apache_beam.options.pipeline_options import PipelineOptions\n",
        "from apache_beam.transforms.window import FixedWindows, Sessions\n",
        "from apache_beam.transforms.trigger import (\n",
        "    AfterWatermark, AfterProcessingTime, AfterCount,\n",
        "    AccumulationMode\n",
        ")\n",
        "from datetime import datetime, timedelta\n",
        "import json\n",
        "import random\n",
        "\n",
        "print(\"Apache Beam version:\", beam.__version__)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 1. Simulate Event Generation"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def generate_sample_events(num_events=1000, late_ratio=0.1):\n",
        "    \"\"\"Generate sample events with some late-arriving data.\"\"\"\n",
        "    event_types = ['page_view', 'click', 'purchase', 'add_to_cart', 'checkout_start']\n",
        "    users = [f'user_{i}' for i in range(1, 101)]\n",
        "    products = [f'prod_{i}' for i in range(1, 51)]\n",
        "    \n",
        "    events = []\n",
        "    base_time = datetime(2024, 1, 15, 10, 0, 0)\n",
        "    \n",
        "    for i in range(num_events):\n",
        "        # Most events on time, some late (up to 2 hours)\n",
        "        if random.random() < late_ratio:\n",
        "            event_time = base_time - timedelta(minutes=random.randint(60, 120))\n",
        "        else:\n",
        "            event_time = base_time + timedelta(minutes=random.randint(0, 60))\n",
        "        \n",
        "        event = {\n",
        "            'event_id': f'evt_{i:06d}',\n",
        "            'event_type': random.choice(event_types),\n",
        "            'user_id': random.choice(users),\n",
        "            'product_id': random.choice(products) if random.random() > 0.3 else None,\n",
        "            'amount': round(random.uniform(10, 500), 2) if random.random() > 0.7 else None,\n",
        "            'event_timestamp': event_time.isoformat(),\n",
        "            'session_id': f'sess_{random.randint(1, 200):04d}',\n",
        "            'country': random.choice(['US', 'UK', 'DE', 'FR', 'JP', 'SG', 'AU', 'CA']),\n",
        "            'device': random.choice(['mobile', 'desktop', 'tablet'])\n",
        "        }\n",
        "        events.append(event)\n",
        "    \n",
        "    return events\n",
        "\n",
        "# Generate sample events\n",
        "sample_events = generate_sample_events(5000, late_ratio=0.15)\n",
        "print(f\"Generated {len(sample_events)} sample events\")\n",
        "print(f\"Sample event: {json.dumps(sample_events[0], indent=2)}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 2. Windowing Concepts Visualization"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Visualize windowing concepts\n",
        "import matplotlib.pyplot as plt\n",
        "import numpy as np\n",
        "\n",
        "# Create timeline\n",
        "base = datetime(2024, 1, 15, 10, 0, 0)\n",
        "times = [base + timedelta(minutes=i) for i in range(0, 120, 5)]\n",
        "\n",
        "# Fixed windows (10 min)\n",
        "fixed_windows = []\n",
        "for t in times:\n",
        "    window_start = t.replace(minute=(t.minute // 10) * 10, second=0, microsecond=0)\n",
        "    window_end = window_start + timedelta(minutes=10)\n",
        "    fixed_windows.append((window_start, window_end))\n",
        "\n",
        "# Session windows (gap = 30 min)\n",
        "session_gaps = []\n",
        "for i in range(len(times) - 1):\n",
        "    gap = (times[i+1] - times[i]).total_seconds() / 60\n",
        "    session_gaps.append(gap)\n",
        "\n",
        "fig, axes = plt.subplots(3, 1, figsize=(14, 10))\n",
        "\n",
        "# Timeline of events\n",
        "event_times = [base + timedelta(minutes=random.randint(0, 120)) for _ in range(50)]\n",
        "event_times.sort()\n",
        "axes[0].eventplot([[(t - base).total_seconds() / 60 for t in event_times]], orientation='horizontal')\n",
        "axes[0].set_title('Event Timeline (50 events over 2 hours)')\n",
        "axes[0].set_xlabel('Minutes from start')\n",
        "axes[0].set_yticks([])\n",
        "\n",
        "# Fixed windows\n",
        "for i, (ws, we) in enumerate(fixed_windows[:12]):\n",
        "    axes[1].axvspan((ws - base).total_seconds() / 60, (we - base).total_seconds() / 60, \n",
        "                    alpha=0.3, label=f'Window {i}' if i < 3 else '')\n",
        "axes[1].set_title('Fixed Windows (10-minute)')\n",
        "axes[1].set_xlabel('Minutes from start')\n",
        "axes[1].set_yticks([])\n",
        "axes[1].legend(loc='upper right')\n",
        "\n",
        "# Session window gaps\n",
        "axes[2].bar(range(len(session_gaps)), session_gaps)\n",
        "axes[2].axhline(y=30, color='r', linestyle='--', label='Session gap threshold (30 min)')\n",
        "axes[2].set_title('Gaps Between Consecutive Events')\n",
        "axes[2].set_xlabel('Event Index')\n",
        "axes[2].set_ylabel('Gap (minutes)')\n",
        "axes[2].legend()\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "print(\"Windowing visualization complete.\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 3. Local Pipeline Simulation (DirectRunner)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "class ParseAndValidate(beam.DoFn):\n",
        "    \"\"\"Parse and validate events, extract event timestamp.\"\"\"\n",
        "    \n",
        "    def process(self, element):\n",
        "        try:\n",
        "            message = json.loads(element) if isinstance(element, str) else element\n",
        "            \n",
        "            # Validate required fields\n",
        "            required = ['event_id', 'event_type', 'user_id', 'event_timestamp']\n",
        "            for field in required:\n",
        "                if field not in message:\n",
        "                    raise ValueError(f'Missing required field: {field}')\n",
        "            \n",
        "            # Parse event timestamp\n",
        "            event_ts = datetime.fromisoformat(message['event_timestamp'].replace('Z', '+00:00'))\n",
        "            \n        "            message['_event_ts'] = event_ts.isoformat()\n",
        "            message['_processing_ts'] = datetime.utcnow().isoformat()\n",
        "            \n",
        "            # Yield with timestamp for event-time processing\n",
        "            yield beam.window.TimestampedValue(message, event_ts.timestamp())\n",
        "            \n",
        "        except Exception as e:\n",
        "            yield beam.pvalue.TaggedOutput('invalid', {\n",
        "                '_raw': element,\n",
        "                '_error': str(e),\n",
        "                '_failed_ts': datetime.utcnow().isoformat()\n",
        "            })\n",
        "\n",
        "class DeduplicateEvents(beam.DoFn):\n",
        "    \"\"\"Deduplicate events by event_id within window.\"\"\"\n",
        "    \n",
        "    def process(self, elements, window=beam.DoFn.WindowParam):\n",
        "        elements_list = list(elements)\n",
        "        if not elements_list:\n",
        "            return\n",
        "        \n        "        # Sort by event timestamp, keep first\n",
        "        sorted_elements = sorted(elements_list, key=lambda x: x.get('_event_ts', ''))\n",
        "        deduped = sorted_elements[0]\n",
        "        deduped['_deduped'] = True\n",
        "        deduped['_duplicate_count'] = len(elements_list)\n",
        "        \n",
        "        yield deduped\n",
        "\n",
        "class CountEventsPerUser(beam.DoFn):\n",
        "    \"\"\"Count events per user per window.\"\"\"\n",
        "    \n",
        "    def process(self, element, window=beam.DoFn.WindowParam):\n",
        "        yield {\n",
        "            'user_id': element['user_id'],\n",
        "            'event_type': element['event_type'],\n",
        "            'window_start': window.start.to_utc_datetime().isoformat(),\n",
        "            'window_end': window.end.to_utc_datetime().isoformat(),\n",
        "            'count': 1\n",
        "        }"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Run local pipeline simulation\n",
        "options = PipelineOptions()\n",
        "options.view_as(beam.options.pipeline_options.StandardOptions).runner = 'DirectRunner'\n",
        "\n",
        "with beam.Pipeline(options=options) as p:\n",
        "    # Create PCollection from sample events\n",
        "    events = p | 'CreateEvents' >> beam.Create([json.dumps(e) for e in sample_events])\n",
        "    \n        "    # Parse and validate with event-time\n",
        "    parsed, invalid = (\n",
        "        events\n",
        "        | 'ParseAndValidate' >> beam.ParDo(ParseAndValidate()).with_outputs('invalid', main='valid')\n",
        "    )\n",
        "    \n        "    # Window into 5-minute fixed windows with 2-hour allowed lateness\n",
        "    windowed = (\n",
        "        parsed\n",
        "        | 'WindowInto' >> beam.WindowInto(\n",
        "            FixedWindows(300),  # 5 minutes\n",
        "            allowed_lateness=timedelta(hours=2),\n",
        "            trigger=AfterWatermark(\n",
        "                early=AfterProcessingTime(60),\n",
        "                late=AfterWatermark(AfterCount(1))\n",
        "            ),\n",
        "            accumulation_mode=AccumulationMode.ACCUMULATING\n",
        "        )\n",
        "    )\n",
        "    \n        "    # Deduplicate by event_id\n",
        "    deduplicated = (\n",
        "        windowed\n",
        "        | 'KeyByEventId' >> beam.Map(lambda x: (x['event_id'], x))\n",
        "        | 'GroupByEventId' >> beam.GroupByKey()\n",
        "        | 'Deduplicate' >> beam.ParDo(DeduplicateEvents())\n",
        "    )\n",
        "    \n        "    # Count events per user per window\n",
        "    user_counts = (\n",
        "        deduplicated\n",
        "        | 'CountPerUser' >> beam.ParDo(CountEventsPerUser())\n",
        "        | 'GroupByUserWindow' >> beam.GroupByKey()\n",
        "        | 'SumCounts' >> beam.Map(lambda kv: {\n",
        "            'user_id': kv[0],\n",
        "            'total_events': sum(x['count'] for x in kv[1]),\n",
        "            'window_start': kv[1][0]['window_start'],\n",
        "            'window_end': kv[1][0]['window_end']\n",
        "        })\n",
        "    )\n",
        "    \n        "    # Collect results\n",
        "    results = user_counts | 'CollectResults' >> beam.combiners.ToList()\n",
        "    \n",
        "    # Print results\n",
        "    _ = results | 'PrintResults' >> beam.Map(print)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 4. Streaming Monitoring Metrics"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Simulate monitoring metrics\n",
        "import pandas as pd\n",
        "\n",
        "# Generate mock metrics data\n",
        "np.random.seed(42)\n",
        "dates = pd.date_range('2024-01-15', periods=24, freq='H')\n",
        "\n",
        "metrics = pd.DataFrame({\n",
        "    'timestamp': dates,\n",
        "    'elements_processed': np.random.poisson(5000, 24) * np.linspace(1, 1.5, 24),\n",
        "    'system_lag_seconds': np.random.gamma(2, 5, 24) + np.linspace(0, 30, 24),\n",
        "    'data_watermark_age_seconds': np.random.gamma(2, 2, 24),\n",
        "    'worker_cpu_utilization': np.random.beta(2, 3, 24) * 80 + 10,\n",
        "    'worker_memory_utilization': np.random.beta(3, 2, 24) * 60 + 20,\n",
        "    'num_workers': np.random.randint(10, 30, 24),\n",
        "    'autoscaling_events': np.random.poisson(2, 24)\n",
        "})\n",
        "\n",
        "fig, axes = plt.subplots(2, 3, figsize=(18, 10))\n",
        "\n",
        "axes[0, 0].plot(metrics['timestamp'], metrics['elements_processed'], 'o-')\n",
        "axes[0, 0].set_title('Elements Processed per Hour')\n",
        "axes[0, 0].tick_params(axis='x', rotation=45)\n",
        "\n",
        "axes[0, 1].plot(metrics['timestamp'], metrics['system_lag_seconds'], 'o-', color='orange')\n",
        "axes[0, 1].axhline(y=60, color='r', linestyle='--', label='Alert threshold (60s)')\n",
        "axes[0, 1].set_title('System Lag (seconds)')\n",
        "axes[0, 1].tick_params(axis='x', rotation=45)\n",
        "axes[0, 1].legend()\n",
        "\n",
        "axes[0, 2].plot(metrics['timestamp'], metrics['data_watermark_age_seconds'], 'o-', color='green')\n",
        "axes[0, 2].set_title('Watermark Age (seconds)')\n",
        "axes[0, 2].tick_params(axis='x', rotation=45)\n",
        "\n",
        "axes[1, 0].plot(metrics['timestamp'], metrics['worker_cpu_utilization'], 'o-', label='CPU %')\n",
        "axes[1, 0].plot(metrics['timestamp'], metrics['worker_memory_utilization'], 'o-', label='Memory %')\n",
        "axes[1, 0].set_title('Worker Utilization')\n",
        "axes[1, 0].tick_params(axis='x', rotation=45)\n",
        "axes[1, 0].legend()\n",
        "\n",
        "axes[1, 1].plot(metrics['timestamp'], metrics['num_workers'], 'o-', color='purple')\n",
        "axes[1, 1].set_title('Active Workers (Autoscaling)')\n",
        "axes[1, 1].tick_params(axis='x', rotation=45)\n",
        "\n",
        "axes[1, 2].bar(metrics['timestamp'], metrics['autoscaling_events'])\n",
        "axes[1, 2].set_title('Autoscaling Events')\n",
        "axes[1, 2].tick_params(axis='x', rotation=45)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "print(\"Key Monitoring Metrics:\")\n",
        "print(f\"  Avg lag: {metrics['system_lag_seconds'].mean():.1f}s\")\n",
        "print(f\"  Max lag: {metrics['system_lag_seconds'].max():.1f}s\")\n",
        "print(f\"  Avg watermark age: {metrics['data_watermark_age_seconds'].mean():.1f}s\")\n",
        "print(f\"  Avg workers: {metrics['num_workers'].mean():.1f}\")\n",
        "print(f\"  Total autoscaling events: {metrics['autoscaling_events'].sum()}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 5. Key Configuration Patterns Summary"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "streaming_config_summary = \"\"\"\n",
        "DATAFLOW STREAMING CONFIGURATION PATTERNS:\n",
        "\n",
        "1. EVENT-TIME PROCESSING (Critical!)\n",
        "   ReadFromPubSub(timestamp_attribute='event_timestamp')\n",
        "   → Tells Dataflow to use event time from message, not processing time\n",
        "\n",
        "2. WINDOWING\n",
        "   FixedWindows(300)           # 5-min fixed windows for aggregations\n",
        "   Sessions(gap=1800)          # 30-min session gap for user journeys\n",
        "   allowed_lateness=timedelta(hours=24)  # Handle late data\n",
        "\n",
        "3. TRIGGERS (When to fire)\n",
        "   AfterWatermark(\n",
        "       early=AfterProcessingTime(60),     # Speculative at 60s\n",
        "       late=AfterWatermark(AfterCount(1)) # Final when watermark passes\n",
        "   )\n",
        "   accumulation_mode=AccumulationMode.ACCUMULATING  # Include late data\n",
        "\n",
        "4. DEDUPLICATION (Exactly-once)\n",
        "   GroupByKey(event_id) within window\n",
        "   Keep earliest event_timestamp\n",
        "\n",
        "5. LATE DATA HANDLING\n",
        "   Side output for late-firing elements\n",
        "   Separate BigQuery table for late data analysis\n",
        "\n",
        "6. MONITORING ALERTS\n",
        "   system_lag > 60s → Alert\n",
        "   data_watermark_age > 300s → Alert\n",
        "   worker_cpu > 85% → Scale up\n",
        "   autoscaling_events > 10/hr → Investigate\n",
        "\n",
        "7. BIGQUERY STREAMING INSERTS\n",
        "   WriteToBigQuery(method='STREAMING_INSERTS')\n",
        "   Partition by event_date, Cluster by user_id, event_type\n",
        "\"\"\"\n",
        "\n",
        "print(streaming_config_summary)"
      ]
    }
  ]
}