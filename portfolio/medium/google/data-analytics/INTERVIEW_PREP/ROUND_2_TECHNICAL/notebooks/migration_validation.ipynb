    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Migration Validation Framework\n",
        "\n",
        "Interactive demonstration of data migration validation patterns:\n",
        "- Row count validation\n",
        "- Checksum comparison\n",
        "- Column profiling\n",
        "- Sample data diffing\n",
        "- Automated reconciliation reports\n",
        "\n",
        "**Use this framework for Teradata/Hadoop → BigQuery migrations.**"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Setup\n",
        "from google.cloud import bigquery\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import hashlib\n",
        "from datetime import datetime\n",
        "import json\n",
        "\n",
        "client = bigquery.Client()\n",
        "PROJECT_ID = 'your-project-id'\n",
        "SOURCE_PROJECT = 'source-project'\n",
        "TARGET_DATASET = 'migration_target'\n",
        "\n",
        "print(f\"Migration Validation Framework initialized\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 1. Row Count Validation"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def validate_row_counts(source_tables: list, target_dataset: str, date_filter: str = None):\n",
        "    \"\"\"Compare row counts between source and target tables.\"\"\"\n",
        "    results = []\n",
        "    \n",
        "    for table in source_tables:\n",
        "        source_table = f\"{SOURCE_PROJECT}.{table['source_dataset']}.{table['name']}\"\n",
        "        target_table = f\"{PROJECT_ID}.{target_dataset}.{table['name']}\"\n",
        "        \n",
        "        where_clause = f\"WHERE {date_filter}\" if date_filter else \"\"\n",
        "        \n",
        "        # Source count\n",
        "        source_query = f\"SELECT COUNT(*) as cnt FROM `{source_table}` {where_clause}\"\n",
        "        source_count = client.query(source_query).result().to_dataframe().iloc[0]['cnt']\n",
        "        \n",
        "        # Target count\n",
        "        target_query = f\"SELECT COUNT(*) as cnt FROM `{target_table}` {where_clause}\"\n",
        "        target_count = client.query(target_query).result().to_dataframe().iloc[0]['cnt']\n",
        "        \n",
        "        diff = target_count - source_count\n",
        "        pct_diff = (diff / source_count * 100) if source_count > 0 else 0\n",
        "        \n",
        "        results.append({\n",
        "            'table': table['name'],\n",
        "            'source_count': source_count,\n",
        "            'target_count': target_count,\n",
        "            'difference': diff,\n",
        "            'pct_difference': pct_diff,\n",
        "            'status': 'PASS' if abs(pct_diff) < 0.1 else 'FAIL'\n",
        "        })\n",
        "    \n",
        "    return pd.DataFrame(results)\n",
        "\n",
        "# Example usage\n",
        "tables_to_validate = [\n",
        "    {'name': 'orders', 'source_dataset': 'teradata_prod'},\n",
        "    {'name': 'customers', 'source_dataset': 'teradata_prod'},\n",
        "    {'name': 'products', 'source_dataset': 'teradata_prod'},\n",
        "    {'name': 'events', 'source_dataset': 'hadoop_prod'},\n",
        "]\n",
        "\n",
        "# df_counts = validate_row_counts(tables_to_validate, TARGET_DATASET, \"order_date >= '2024-01-01'\")\n",
        "# print(df_counts.to_string())"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 2. Checksum Validation (MD5 of concatenated columns)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def validate_checksums(source_table: str, target_table: str, \n",
        "                        key_columns: list, compare_columns: list,\n",
        "                        batch_size: int = 100000):\n",
        "    \"\"\"Validate data integrity using checksums on key+compare columns.\"\"\"\n",
        "    \n",
        "    # Build checksum query\n",
        "    key_cols = ', '.join(key_columns)\n",
        "    compare_cols = ', '.join(compare_columns)\n",
        "    all_cols = key_columns + compare_columns\n",
        "    \n",
        "    # Use TO_JSON_STRING for consistent hashing across systems\n",
        "    checksum_expr = f\"TO_HEX(MD5(TO_JSON_STRING(STRUCT({compare_cols}))))\"\n",
        "    \n",
        "    query = f\"\"\"\n",
        "    SELECT {key_cols}, {checksum_expr} as row_checksum\n",
        "    FROM `{table}`\n",
        "    ORDER BY {key_cols}\n",
        "    \"\"\".format(key_cols=key_cols, checksum_expr=checksum_expr, table='{table}')\n",
        "    \n",
        "    # Execute on source and target\n",
        "    source_df = client.query(query.format(table=source_table)).result().to_dataframe()\n",
        "    target_df = client.query(query.format(table=target_table)).result().to_dataframe()\n",
        "    \n",
        "    # Merge and compare\n",
        "    merged = source_df.merge(target_df, on=key_columns, suffixes=('_src', '_tgt'), how='outer', indicator=True)\n",
        "    \n",
        "    mismatches = merged[merged['row_checksum_src'] != merged['row_checksum_tgt']]\n",
        "    missing_in_target = merged[merged['_merge'] == 'left_only']\n",
        "    extra_in_target = merged[merged['_merge'] == 'right_only']\n",
        "    \n",
        "    return {\n",
        "        'total_rows_source': len(source_df),\n",
        "        'total_rows_target': len(target_df),\n",
        "        'mismatched_rows': len(mismatches),\n",
        "        'missing_in_target': len(missing_in_target),\n",
        "        'extra_in_target': len(extra_in_target),\n",
        "        'match_rate': (len(source_df) - len(mismatches) - len(missing_in_target)) / len(source_df) * 100 if len(source_df) > 0 else 100,\n",
        "        'mismatch_samples': mismatches.head(10).to_dict('records') if len(mismatches) > 0 else []\n",
        "    }"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 3. Column Profiling Comparison"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def profile_column(table: str, column: str, date_filter: str = None):\n",
        "    \"\"\"Get column profile statistics.\"\"\"\n",
        "    where_clause = f\"WHERE {date_filter}\" if date_filter else \"\"\n",
        "    \n",
        "    query = f\"\"\"\n",
        "    SELECT \n",
        "      COUNT(*) as total_rows,\n",
        "      COUNT({col}) as non_null_count,\n",
        "      COUNT(DISTINCT {col}) as distinct_count,\n",
        "      MIN({col}) as min_value,\n",
        "      MAX({col}) as max_value,\n",
        "      AVG(CAST({col} AS FLOAT64)) as avg_value,\n",
        "      APPROX_QUANTILES({col}, 100)[OFFSET(50)] as median_value,\n",
        "      APPROX_QUANTILES({col}, 100)[OFFSET(25)] as p25,\n",
        "      APPROX_QUANTILES({col}, 100)[OFFSET(75)] as p75\n",
        "    FROM `{table}`\n",
        "    {where}\n",
        "    \"\"\".format(col=column, table=table, where=where_clause)\n",
        "    \n",
        "    return client.query(query).result().to_dataframe().iloc[0].to_dict()\n",
        "\n",
        "def compare_column_profiles(source_table: str, target_table: str, \n",
        "                           columns: list, date_filter: str = None):\n",
        "    \"\"\"Compare column profiles between source and target.\"\"\"\n",
        "    results = []\n",
        "    \n",
        "    for col in columns:\n",
        "        src_profile = profile_column(source_table, col, date_filter)\n",
        "        tgt_profile = profile_column(target_table, col, date_filter)\n",
        "        \n",
        "        # Calculate differences\n",
        "        diff = {}\n",
        "        for key in ['total_rows', 'non_null_count', 'distinct_count', 'avg_value']:\n",
        "            src_val = src_profile.get(key, 0)\n",
        "            tgt_val = tgt_profile.get(key, 0)\n",
        "            if src_val != 0:\n",
        "                diff[key] = ((tgt_val - src_val) / src_val) * 100\n",
        "            else:\n",
        "                diff[key] = 0 if tgt_val == 0 else float('inf')\n",
        "        \n",
        "        results.append({\n",
        "            'column': col,\n",
        "            'source': src_profile,\n",
        "            'target': tgt_profile,\n",
        "            'pct_diff': diff,\n",
        "            'status': 'PASS' if all(abs(v) < 1 for v in diff.values()) else 'REVIEW'\n",
        "        })\n",
        "    \n",
        "    return pd.DataFrame(results)"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 4. Sample Data Diffing"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def sample_data_diff(source_table: str, target_table: str,\n",
        "                    key_columns: list, sample_size: int = 1000):\n",
        "    \"\"\"Compare random samples from source and target.\"\"\"\n",
        "    \n",
        "    key_cols = ', '.join(key_columns)\n",
        "    \n",
        "    # Get random sample from source\n",
        "    sample_query = f\"\"\"\n",
        "    SELECT * FROM `{table}`\n",
        "    WHERE RAND() < {sample_rate}\n",
        "    LIMIT {limit}\n",
        "    \"\"\".format(table='{table}', sample_rate=sample_size/1000000, limit=sample_size)\n",
        "    \n",
        "    src_sample = client.query(sample_query.format(table=source_table)).result().to_dataframe()\n",
        "    \n",
        "    # Find matching rows in target\n",
        "    if len(src_sample) > 0:\n",
        "        # Build IN clause for keys\n",
        "        key_values = src_sample[key_columns].drop_duplicates()\n",
        "        \n",
        "        # For each key, find in target\n",
        "        mismatches = []\n",
        "        for _, row in key_values.iterrows():\n",
        "            where_conditions = ' AND '.join([f\"{k} = '{row[k]}'\" for k in key_columns])\n",
        "            tgt_query = f\"SELECT * FROM `{target_table}` WHERE {where_conditions}\"\n",
        "            tgt_rows = client.query(tgt_query).result().to_dataframe()\n",
        "            \n",
        "            src_rows = src_sample[\n",
        "                (src_sample[key_columns] == row[key_columns].values).all(axis=1)\n",
        "            ]\n",
        "            \n",
        "            if len(tgt_rows) != len(src_rows):\n",
        "                mismatches.append({\n",
        "                    'keys': row[key_columns].to_dict(),\n",
        "                    'source_count': len(src_rows),\n",
        "                    'target_count': len(tgt_rows),\n",
        "                    'issue': 'row_count_mismatch'\n",
        "                })\n",
        "            else:\n",
        "                # Compare all columns\n",
        "                for i in range(len(src_rows)):\n",
        "                    src_row = src_rows.iloc[i]\n",
        "                    tgt_row = tgt_rows.iloc[i]\n",
        "                    diff_cols = []\n",
        "                    for col in src_row.index:\n",
        "                        if col not in key_columns and src_row[col] != tgt_row[col]:\n",
        "                            diff_cols.append({\n",
        "                                'column': col,\n",
        "                                'source': src_row[col],\n",
        "                                'target': tgt_row[col]\n",
        "                            })\n",
        "                    if diff_cols:\n",
        "                        mismatches.append({\n",
        "                            'keys': row[key_columns].to_dict(),\n",
        "                            'column_differences': diff_cols\n",
        "                        })\n",
        "    \n",
        "    return {\n",
        "        'sample_size': len(src_sample),\n",
        "        'mismatch_count': len(mismatches),\n",
        "        'mismatches': mismatches[:20]  # Limit output\n",
        "    }"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 5. Automated Reconciliation Report"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "def generate_reconciliation_report(tables: list, target_dataset: str,\n",
        "                                   date_filter: str = None) -> dict:\n",
        "    \"\"\"Generate comprehensive migration reconciliation report.\"\"\"\n",
        "    \n",
        "    report = {\n",
        "        'generated_at': datetime.utcnow().isoformat(),\n",
        "        'project': PROJECT_ID,\n",
        "        'target_dataset': target_dataset,\n",
        "        'date_filter': date_filter,\n",
        "        'tables': {}\n",
        "    }\n",
        "    \n",
        "    overall_status = 'PASS'\n",
        "    \n",
        "    for table in tables:\n",
        "        table_name = table['name']\n",
        "        source_table = f\"{SOURCE_PROJECT}.{table['source_dataset']}.{table_name}\"\n",
        "        target_table = f\"{PROJECT_ID}.{target_dataset}.{table_name}\"\n",
        "        key_columns = table.get('key_columns', ['id'])\n",
        "        \n",
        "        print(f\"Validating {table_name}...\")\n",
        "        \n",
        "        # 1. Row count\n",
        "        count_result = validate_row_counts([table], target_dataset, date_filter)\n",
        "        \n",
        "        # 2. Column profiling (key columns)\n",
        "        profile_cols = key_columns + table.get('profile_columns', [])\n",
        "        profile_result = compare_column_profiles(source_table, target_table, profile_cols, date_filter)\n",
        "        \n",
        "        # 3. Sample diff\n",
        "        diff_result = sample_data_diff(source_table, target_table, key_columns)\n",
        "        \n",
        "        table_status = 'PASS'\n",
        "        if count_result.iloc[0]['status'] == 'FAIL':\n",
        "            table_status = 'FAIL'\n",
        "        elif any(profile_result['status'] == 'REVIEW'):\n",
        "            table_status = 'REVIEW'\n",
        "        elif diff_result['mismatch_count'] > 0:\n",
        "            table_status = 'REVIEW'\n",
        "        \n        "        if table_status != 'PASS':\n",
        "            overall_status = 'FAIL' if table_status == 'FAIL' else 'REVIEW'\n",
        "        \n",
        "        report['tables'][table_name] = {\n",
        "            'status': table_status,\n",
        "            'row_count': count_result.iloc[0].to_dict(),\n",
        "            'column_profiles': profile_result.to_dict('records'),\n",
        "            'sample_diff': diff_result\n",
        "        }\n",
        "    \n",
        "    report['overall_status'] = overall_status\n",
        "    \n",
        "    return report"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## 6. Migration Dashboard Visualization"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Visualize migration validation results\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "# Mock data for visualization\n",
        "mock_results = pd.DataFrame({\n",
        "    'table': ['orders', 'customers', 'products', 'events', 'sessions', 'payments'],\n",
        "    'source_rows': [5000000, 1000000, 50000, 25000000, 8000000, 3000000],\n",
        "    'target_rows': [5000000, 1000000, 50000, 24999950, 8000000, 3000000],\n",
        "    'pct_diff': [0.0, 0.0, 0.0, -0.0002, 0.0, 0.0],\n",
        "    'status': ['PASS', 'PASS', 'PASS', 'REVIEW', 'PASS', 'PASS']\n",
        "})\n",
        "\n",
        "fig, axes = plt.subplots(2, 2, figsize=(14, 10))\n",
        "\n",
        "# Row count comparison\n",
        "x = range(len(mock_results))\n",
        "width = 0.35\n",
        "axes[0, 0].bar([i - width/2 for i in x], mock_results['source_rows'], width, label='Source', alpha=0.8)\n",
        "axes[0, 0].bar([i + width/2 for i in x], mock_results['target_rows'], width, label='Target', alpha=0.8)\n",
        "axes[0, 0].set_xticks(x)\n",
        "axes[0, 0].set_xticklabels(mock_results['table'], rotation=45)\n",
        "axes[0, 0].set_ylabel('Row Count')\n",
        "axes[0, 0].set_title('Row Count: Source vs Target')\n",
        "axes[0, 0].legend()\n",
        "axes[0, 0].set_yscale('log')\n",
        "\n",
        "# Percentage difference\n",
        "colors = ['green' if s == 'PASS' else 'orange' for s in mock_results['status']]\n",
        "axes[0, 1].bar(mock_results['table'], mock_results['pct_diff'] * 100, color=colors)\n",
        "axes[0, 1].axhline(y=0, color='black', linewidth=0.5)\n",
        "axes[0, 1].axhline(y=0.1, color='red', linestyle='--', label='Threshold (0.1%)')\n",
        "axes[0, 1].axhline(y=-0.1, color='red', linestyle='--')\n",
        "axes[0, 1].set_ylabel('% Difference')\n",
        "axes[0, 1].set_title('Row Count % Difference')\n",
        "axes[0, 1].tick_params(axis='x', rotation=45)\n",
        "axes[0, 1].legend()\n",
        "\n",
        "# Status summary\n",
        "status_counts = mock_results['status'].value_counts()\n",
        "axes[1, 0].pie(status_counts.values, labels=status_counts.index, autopct='%1.1f%%', \n",
        "               colors=['green', 'orange', 'red'][:len(status_counts)])\n",
        "axes[1, 0].set_title('Validation Status Summary')\n",
        "\n",
        "# Cumulative migration progress\n",
        "dates = pd.date_range('2024-01-01', periods=30, freq='D')\n",
        "progress = np.cumsum(np.random.normal(3.3, 0.5, 30))\n",
        "progress = np.minimum(progress, 100)\n",
        "axes[1, 1].plot(dates, progress, 'o-')\n",
        "axes[1, 1].axhline(y=100, color='green', linestyle='--', label='Complete')\n",
        "axes[1, 1].set_title('Migration Progress Over Time')\n",
        "axes[1, 1].set_ylabel('% Complete')\n",
        "axes[1, 1].tick_params(axis='x', rotation=45)\n",
        "axes[1, 1].legend()\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "print(mock_results.to_string())"
      ]
    },
