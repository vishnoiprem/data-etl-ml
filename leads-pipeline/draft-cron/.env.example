# Avilx leads-pipeline — environment variables
# Copy to .env and fill in. auto_loop.sh will read from env at startup.

# ── Database ────────────────────────────────────────────────────────────
AVILX_DB_HOST=localhost
AVILX_DB_PORT=5433
AVILX_DB_NAME=avilx_leads
AVILX_DB_USER=avilx
AVILX_DB_PASSWORD=avilx

# ── Outbound email (Gmail SMTP) ─────────────────────────────────────────
AVILX_GMAIL_USER=you@gmail.com
AVILX_GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
AVILX_FROM_NAME=Prem Vishnoi
AVILX_FROM_EMAIL=prem@avilx.com

# ── Inbound email (Gmail IMAP, for bounce detection) ────────────────────
AVILX_IMAP_HOST=imap.gmail.com
AVILX_IMAP_PORT=993
AVILX_IMAP_USER=you@gmail.com
AVILX_IMAP_PASSWORD=xxxx xxxx xxxx xxxx
# Look back N days when scanning for bounces
AVILX_BOUNCE_SINCE_DAYS=7

# ── Auto-loop tuning ───────────────────────────────────────────────────
LOOP_MAX=100
LOOP_SLEEP=90
REFINE_ONLY=1
AVILX_LOOP_LOG=/tmp/auto_loop.log
AVILX_LOOP_PIDFILE=/tmp/auto_loop.pid

# ── Cover-letter branding (override for white-label sub-brands) ─────────
AVILX_NAME=Avilx
AVILX_TAGLINE=Global Build · Deploy · Engineers
AVILX_WEBSITE=avilx.com
AVILX_EMAIL=hello@avilx.com
AVILX_WHATSAPP=+6592716405
AVILX_FOUNDER=Prem Vishnoi
AVILX_HQ=Ha Noi, Vietnam

# ── Misc ───────────────────────────────────────────────────────────────
# Path to bounce-deny JSON file (default: ./state/bounce_deny.json)
AVILX_BOUNCE_DENY_PATH=
# Override the python interpreter used by auto_loop.sh
AVILX_PY=

# ── X.com (Twitter) auth — required for scrape_x_com() ────────────────
# Get these from DevTools → Application → Cookies → https://x.com
# Or run: bin/extract_x_cookies.py  (opens a real browser, you log in,
# cookies are written to state/x_cookies.json automatically)
#   - auth_token: HttpOnly, ~40 char random string
#   - ct0: csrf token, ~32 chars; rotates when you log out
# If unset, scrape_x_com() logs a clear "skipping" message and returns [].
AVILX_X_AUTH_TOKEN=
AVILX_X_CT0=
# Path to JSON list of cookies (alternative to the env vars above)
AVILX_X_COOKIES_PATH=
# Comma-separated search queries for X.com (default below)
AVILX_X_QUERIES=AI engineer hiring,ML engineer remote,senior AI hiring,china remote AI hiring,USA remote AI hiring

# ── Legacy aliases (still read by some scripts) ────────────────────────
YOUR_NAME=${AVILX_FOUNDER}
YOUR_COMPANY=${AVILX_NAME}
YOUR_EMAIL=${AVILX_EMAIL}
YOUR_PHONE=${AVILX_WHATSAPP}
YOUR_WEBSITE=https://${AVILX_WEBSITE}
GMAIL_ADDRESS=${AVILX_GMAIL_USER}
GMAIL_APP_PASSWORD=${AVILX_GMAIL_APP_PASSWORD}
RESUME_DIR=/Users/vishnoiprem/PycharmProjects/data-etl-ml/Resume

# ── Sending config ────────────────────────────────────────────────────
DAILY_LIMIT=10
DELAY_BETWEEN_EMAILS_SEC=120  # 2 min between sends (avoid spam flags)
DRY_RUN=false  # set true to preview without sending
