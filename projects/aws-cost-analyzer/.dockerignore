# Keep the build context small and the image reproducible.
#
# The Dockerfile copies only `requirements.txt`, `src/` and `app.py`, but
# Docker still sends the whole context to the daemon unless it is
# excluded here — so anything ignored below is never uploaded.

# Test and lint tooling are not needed at runtime. The Dockerfile's
# `pip install -r requirements.txt` DOES pull pytest/ruff in (they are
# in the manifest), so this only avoids uploading the test tree.
tests/
scripts/

# Local artifacts — regenerated by `make demo`.
reports/
data/

# Python build noise.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# VCS and editor noise.
.git/
.gitignore
.idea/
.vscode/
.DS_Store

# Container definitions themselves.
Dockerfile
.dockerignore

# Docs are not needed in the runtime image.
README.md
