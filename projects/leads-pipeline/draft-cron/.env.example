# Avilx leads-pipeline — environment variables
# Copy to .env and fill in. auto_loop.sh will read from env at startup.

# ── Database ────────────────────────────────────────────────────────────
AVILX_DB_HOST=localhost
AVILX_DB_PORT=5433
AVILX_DB_NAME=avilx_leads
AVILX_DB_USER=avilx
AVILX_DB_PASSWORD=avilx

# ── Outbound email (Gmail SMTP) ─────────────────────────────────────────
AVILX_GMAIL_USER=you@gmail.com
AVILX_GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
AVILX_FROM_NAME=Alex Morgan
AVILX_FROM_EMAIL=alex.morgan@avilx.com
# MAIL FROM (envelope sender). Defaults to AVILX_FROM_EMAIL. Only needs to be
# set when the sending provider uses its own bounce domain (Mailgun/SendGrid).
# AVILX_ENVELOPE_FROM=
# Where replies should land. Defaults to AVILX_FROM_EMAIL.
# AVILX_REPLY_TO=alex.morgan@avilx.com
# One-click unsubscribe mailbox. Defaults to AVILX_EMAIL (hello@avilx.com) —
# keep this on the generic mailbox, NOT the sender address.
# AVILX_UNSUB_EMAIL=hello@avilx.com

# ── Outbound transport ────────────────────────────────────────────────
# Which SMTP auth to use. gmail = password login (works today);
# oauth2 = Outlook SMTP AUTH, the only way mail can genuinely arrive
# from alex.morgan@avilx.com (Gmail rewrites the From address).
# See SETUP_OUTLOOK_SMTP.md before flipping this to oauth2.
SMTP_AUTH=gmail
# Host/port for the active auth mode. The values below are the Outlook
# ones; for gmail, leave SMTP_AUTH=gmail and the defaults apply
# (smtp.gmail.com:465, SSL).
AVILX_SMTP_HOST=smtp.gmail.com
AVILX_SMTP_PORT=465
AVILX_SMTP_USE_SSL=true
# AVILX_SMTP_USER=you@gmail.com
# AVILX_SMTP_PASS=xxxx xxxx xxxx xxxx

# ── Microsoft 365 / Outlook SMTP AUTH (SMTP_AUTH=oauth2) ──────────────
# Register the app first: SETUP_OUTLOOK_SMTP.md
AVILX_M365_CLIENT_ID=
AVILX_M365_CLIENT_SECRET=
AVILX_M365_TENANT_ID=NETORGFT20933709.onmicrosoft.com
# The mailbox being authenticated. Outlook SMTP AUTH may only send as this
# mailbox or one it has Send As permission for.
AVILX_M365_SENDER=alex.morgan@avilx.com
# Where the OAuth token cache lives (written 0600 by lib/m365_auth.py).
AVILX_M365_TOKEN_PATH=./state/m365_token.json

# ── Inbound email (Gmail IMAP, for bounce detection) ────────────────────
AVILX_IMAP_HOST=imap.gmail.com
AVILX_IMAP_PORT=993
AVILX_IMAP_USER=you@gmail.com
AVILX_IMAP_PASSWORD=xxxx xxxx xxxx xxxx
# Look back N days when scanning for bounces
AVILX_BOUNCE_SINCE_DAYS=7

# ── Auto-loop tuning ───────────────────────────────────────────────────
LOOP_MAX=100
LOOP_SLEEP=90
REFINE_ONLY=1
AVILX_LOOP_LOG=/tmp/auto_loop.log
AVILX_LOOP_PIDFILE=/tmp/auto_loop.pid

# ── Cover-letter branding (override for white-label sub-brands) ─────────
AVILX_NAME=Avilx
AVILX_TAGLINE=Global Build · Deploy · Engineers
AVILX_WEBSITE=avilx.com
AVILX_EMAIL=alex.morgan@avilx.com
AVILX_WHATSAPP=+84963009439
AVILX_FOUNDER=Alex Morgan
AVILX_HQ=Ha Noi, Vietnam

# ── Misc ───────────────────────────────────────────────────────────────
# Path to bounce-deny JSON file (default: ./state/bounce_deny.json)
AVILX_BOUNCE_DENY_PATH=
# Override the python interpreter used by auto_loop.sh
AVILX_PY=

# ── X.com (Twitter) auth — required for scrape_x_com() ────────────────
# Get these from DevTools → Application → Cookies → https://x.com
# Or run: bin/extract_x_cookies.py  (opens a real browser, you log in,
# cookies are written to state/x_cookies.json automatically)
#   - auth_token: HttpOnly, ~40 char random string
#   - ct0: csrf token, ~32 chars; rotates when you log out
# If unset, scrape_x_com() logs a clear "skipping" message and returns [].
AVILX_X_AUTH_TOKEN=
AVILX_X_CT0=
# Path to JSON list of cookies (alternative to the env vars above)
AVILX_X_COOKIES_PATH=
# Comma-separated search queries for X.com (default below)
AVILX_X_QUERIES=AI engineer hiring,ML engineer remote,senior AI hiring,china remote AI hiring,USA remote AI hiring

# ── Legacy aliases (still read by some scripts) ────────────────────────
# YOUR_NAME/YOUR_EMAIL must track the From identity, not the founder
# record — otherwise a script renders one sender in the body while the
# header shows another.
YOUR_NAME=${AVILX_FROM_NAME}
YOUR_EMAIL=${AVILX_FROM_EMAIL}
YOUR_COMPANY=${AVILX_NAME}
YOUR_PHONE=${AVILX_WHATSAPP}
YOUR_WHATSAPP=${AVILX_WHATSAPP}
YOUR_WEBSITE=https://${AVILX_WEBSITE}
GMAIL_ADDRESS=${AVILX_GMAIL_USER}
GMAIL_APP_PASSWORD=${AVILX_GMAIL_APP_PASSWORD}
RESUME_DIR=/Users/vishnoiprem/PycharmProjects/data-etl-ml/Resume

# ── Sending config ────────────────────────────────────────────────────
DAILY_LIMIT=10
DELAY_BETWEEN_EMAILS_SEC=120  # 2 min between sends (avoid spam flags)
DRY_RUN=false  # set true to preview without sending
